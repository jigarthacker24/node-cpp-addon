{
  "name": "cpp-addon",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "setup": "npm install && npm run build",
    "build": "make -C clibs mac install && node-gyp rebuild",
    "start": "node index.js",
    "test": "node index.js",
    "clean": "make -C clibs clean && node-gyp clean && rm -rf build/ node_modules/ && rm -rf *.so *.dylib"
  },
  "keywords": [
    "node",
    "cpp",
    "addon",
    "napi"
  ],
  "author": "",
  "license": "ISC",
  "description": "Node.js addon example with C++",
  "dependencies": {
    "node-addon-api": "^7.1.1"
  },
  "devDependencies": {
    "node-gyp": "^10.3.1"
  },
  "gypfile": true
}
